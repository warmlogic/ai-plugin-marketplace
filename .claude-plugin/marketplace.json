{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "ai-plugin-marketplace",
  "owner": {
    "name": "Matt Mollison",
    "email": "matt.mollison@gmail.com"
  },
  "metadata": {
    "description": "Public AI coding tool plugin marketplace — safety, quality, and productivity plugins for Claude Code and compatible tools"
  },
  "plugins": [
    {
      "name": "bash-guardrails",
      "source": {
        "source": "github",
        "repo": "warmlogic/claude-bash-guardrails",
        "ref": "main"
      },
      "description": "Trap-only PreToolUse hook for Claude Code's Bash tool: denies commands zsh will reject, like an unquoted --include=*.md glob or [ a == b ], with a one-line fix, and stays silent otherwise",
      "author": {
        "name": "Matt Mollison"
      },
      "homepage": "https://github.com/warmlogic/claude-bash-guardrails",
      "repository": "https://github.com/warmlogic/claude-bash-guardrails",
      "license": "MIT",
      "category": "quality",
      "keywords": ["bash", "hooks", "zsh", "guardrails"],
      "tags": ["bash", "hooks", "zsh", "guardrails"]
    },
    {
      "name": "mdlint",
      "source": {
        "source": "github",
        "repo": "warmlogic/claude-mdlint",
        "ref": "main"
      },
      "description": "Auto-format and lint markdown files written by Claude Code — prettier + markdownlint on every Write/Edit",
      "author": {
        "name": "Matt Mollison"
      },
      "homepage": "https://github.com/warmlogic/claude-mdlint",
      "repository": "https://github.com/warmlogic/claude-mdlint",
      "license": "MIT",
      "category": "quality",
      "keywords": ["markdown", "linting", "formatting", "hooks"],
      "tags": ["markdown", "linting", "formatting", "hooks"]
    }
  ]
}
