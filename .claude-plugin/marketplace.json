{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "ai-plugin-marketplace",
  "owner": {
    "name": "Matt Mollison",
    "email": "matt.mollison@gmail.com"
  },
  "metadata": {
    "description": "Public AI coding tool plugin marketplace — safety, quality, and productivity plugins for Claude Code and compatible tools"
  },
  "plugins": [
    {
      "name": "mdlint",
      "source": {
        "source": "github",
        "repo": "warmlogic/claude-mdlint",
        "ref": "main"
      },
      "description": "Auto-format and lint markdown files written by Claude Code — prettier + markdownlint on every Write/Edit",
      "author": {
        "name": "Matt Mollison"
      },
      "homepage": "https://github.com/warmlogic/claude-mdlint",
      "repository": "https://github.com/warmlogic/claude-mdlint",
      "license": "MIT",
      "category": "quality",
      "keywords": ["markdown", "linting", "formatting", "hooks"],
      "tags": ["markdown", "linting", "formatting", "hooks"]
    },
    {
      "name": "hintline",
      "source": {
        "source": "github",
        "repo": "warmlogic/claude-hintline",
        "ref": "main"
      },
      "description": "Model, context, and rate-limit usage in the prompt hint, drawn in-process with no process launches",
      "author": {
        "name": "Matt Mollison"
      },
      "homepage": "https://github.com/warmlogic/claude-hintline",
      "repository": "https://github.com/warmlogic/claude-hintline",
      "license": "MIT",
      "category": "productivity",
      "keywords": ["statusline", "usage", "context", "mods"],
      "tags": ["statusline", "usage", "context", "mods"]
    },
    {
      "name": "roborev-companion",
      "source": {
        "source": "github",
        "repo": "warmlogic/claude-roborev-companion",
        "ref": "main"
      },
      "description": "Companion to roborev per-push AI review: roborev-wait-push waits on a push's review (batched range jobs included) and reports the verdict, and a skill covers judging verdicts and dispositioning findings",
      "author": {
        "name": "Matt Mollison"
      },
      "homepage": "https://github.com/warmlogic/claude-roborev-companion",
      "repository": "https://github.com/warmlogic/claude-roborev-companion",
      "license": "MIT",
      "category": "quality",
      "keywords": ["roborev", "code-review", "git-hooks"],
      "tags": ["roborev", "code-review", "git-hooks"]
    },
    {
      "name": "local-llm",
      "source": {
        "source": "github",
        "repo": "warmlogic/claude-local-llm",
        "ref": "main"
      },
      "description": "On request, run bounded text jobs on big files (classify, extract, check claims) on a model running locally in LM Studio, over loopback only",
      "author": {
        "name": "Matt Mollison"
      },
      "homepage": "https://github.com/warmlogic/claude-local-llm",
      "repository": "https://github.com/warmlogic/claude-local-llm",
      "license": "MIT",
      "category": "productivity",
      "keywords": ["local-llm", "lm-studio", "mcp", "delegation"],
      "tags": ["local-llm", "lm-studio", "mcp", "delegation"]
    }
  ],
  "renames": {
    "bash-guardrails": null
  }
}
